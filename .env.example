# === Zalo Bot SDK Test Environment Configuration ===

# Required: The access token of your Zalo Bot (get it from Zalo Developer Portal)
# This token is used to authenticate all API requests.
ZALO_BOT_TOKEN=YOUR_ZALO_BOT_TOKEN_HERE

# Optional: The Zalo User ID to send test messages/photos/stickers to.
# This should be the ID of a user who has already interacted with your bot.
TEST_USER_ID=YOUR_TEST_USER_ID_HERE
